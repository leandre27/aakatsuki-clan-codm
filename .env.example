# Production
NODE_ENV=production
PORT=3000
# 1 si le serveur est derrière un proxy HTTPS (Caddy, Nginx, Render, Railway...)
TRUST_PROXY=1
# Base MySQL / MariaDB (sans cette ligne : SQLite dans DATA_DIR)
DATABASE_URL=mysql://utilisateur:motdepasse@127.0.0.1:3306/aakatsuki
# Dossier persistant : sauvegardes quotidiennes, clés des notifications (et base SQLite si pas de MySQL)
DATA_DIR=/data
# Tests MySQL (npm run test:mysql) : base réservée aux tests, VIDÉE à chaque lancement
# TEST_DATABASE_URL=mysql://utilisateur:motdepasse@127.0.0.1:3306/aakatsuki_test
# Fuseau horaire du clan (horaires des séances et rappels), ex. Africa/Abidjan ou Europe/Paris
TZ=
# Premier démarrage : un compte par membre de server/roster.js,
# identifiants provisoires écrits dans DATA_DIR/identifiants.txt
# Contact transmis aux services de notifications (obligatoire pour les iPhone)
PUSH_SUBJECT=mailto:
# Démo fictive : jamais en production
DEMO=0
# Nombre de sauvegardes conservées
BACKUP_KEEP=14
